e8176","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1761264432390,"user_tz":360,"elapsed":16,"user":{"displayName":"Johir Babor","userId":"12071800784136629308"}},"outputId":"172bd717-b095-492f-cd13-c59fe639b9d5"},"outputs":[{"output_type":"stream","name":"stdout","text":["Hello, World! Welcome to the Student Gradebook Management System.\n"]}],"source":["# In the space below, please print \"Hello, World! Welcome to the Student Gradebook Management System.\"\n","print(\"Hello, World! Welcome to the Student Gradebook Management System.\")"]},{"cell_type":"code","execution_count":16,"id":"l3Venmnzsq2m","metadata":{"id":"l3Venmnzsq2m","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1761264476559,"user_tz":360,"elapsed":70,"user":{"displayName":"Johir Babor","userId":"12071800784136629308"}},"outputId":"65db7b10-4f74-44e9-b86d-52595a1160d5"},"outputs":[{"output_type":"stream","name":"stdout","text":["This is implemented by Group {lab_group_number 25}, for ENGG680 {intake_semester Fall} of {intake_year 2025}\n"]}],"source":["# Fill in your information using the defined variables below:\n","# (1 mark)\n","lab_group_number = 25\n","intake_year = 2025\n","intake_semester = \"Fall\"\n","\n","# Using f-strings and the variables above, print \"This is implemented by Group <lab_group_number>, for ENGG680 <intake_semester> of <intake_year>\"\n","# (1 marks)\n","print(\"This is implemented by Group {lab_group_number 25}, for ENGG680 {intake_semester Fall} of {intake_year 2025}\")\n"]},{"cell_type":"code","execution_count":17,"id":"mX5gdzQGp9Bu","metadata":{"id":"mX5gdzQGp9Bu","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1761264512641,"user_tz":360,"elapsed":22,"user":{"displayName":"Johir Babor","userId":"12071800784136629308"}},"outputId":"ede4ebe5-9ea3-44aa-d2d8-c4184ff9ee45"},"outputs":[{"output_type":"stream","name":"stdout","text":["Our Group Members include Abdullah, Venkata Sai Vijaya Bhaskar, Taha, Johir\n"]}],"source":["# Similarly, create variables for each of your group members (eg. member_1, member_2....) and assign them your first names.\n","# Then, using f-strings and the variables above, print the following sentence:\n","# \"Our Group Members include <member_1>, <member_2>, ...\"\n","# (1 marks)\n","member_1 = \"Abdullah\"\n","member_2 = \"Venkata Sai Vijaya Bhaskar\"\n","member_3 = \"Taha\"\n","member_4 = \"Johir\"\n","print(f\"Our Group Members include {member_1}, {member_2}, {member_3}, {member_4}\")"]},{"cell_type":"code","execution_count":18,"id":"mTPZ16XEtnHV","metadata":{"id":"mTPZ16XEtnHV","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1761264532204,"user_tz":360,"elapsed":15,"user":{"displayName":"Johir Babor","userId":"12071800784136629308"}},"outputId":"52bf6ca9-89ee-4049-ea71-5640ec7b138a"},"outputs":[{"output_type":"stream","name":"stdout","text":["The subjects involved in this grading system is English and Math.\n"]}],"source":["# Use indexing to print \"The subjects involved in this grading system is English and Math.\" using \"subjects\" below.\n","# (1 marks)\n","subjects = (\"English\", \"Math\")\n","print(f\"The subjects involved in this grading system is {subjects[0]} and {subjects[1]}.\")"]},{"cell_type":"markdown","id":"Cew8JQKs8IlV","metadata":{"id":"Cew8JQKs8IlV"},"source":["## Part 2: Python Fundamentals\n","### (11 Marks)"]},{"cell_type":"code","execution_count":19,"id":"lf2eJW36AHJn","metadata":{"id":"lf2eJW36AHJn","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1761264624871,"user_tz":360,"elapsed":30,"user":{"displayName":"Johir Babor","userId":"12071800784136629308"}},"outputId":"61d4316f-d650-4882-d83f-6d78e5ab3609"},"outputs":[{"output_type":"stream","name":"stdout","text":["Original list: ['Calgary', 'Edmonton', 'Red Deer', 'Lethbridge', 'Okotoks']\n","After adding a city: ['Calgary', 'Edmonton', 'Red Deer', 'Lethbridge', 'Okotoks', 'Canmore']\n","After removing the second city: ['Calgary', 'Red Deer', 'Lethbridge', 'Okotoks', 'Canmore']\n","After sorting: ['Calgary', 'Canmore', 'Lethbridge', 'Okotoks', 'Red Deer']\n","Final list: ['Calgary', 'Canmore', 'Lethbridge', 'Okotoks', 'Red Deer']\n"]}],"source":["# Lists (2 marks)\n","\n","# 1. Create a list of any 5 cities in Alberta.\n","cities = [\"Calgary\", \"Edmonton\", \"Red Deer\", \"Lethbridge\", \"Okotoks\"]\n","# 2. Print the list\n","print(\"Original list:\", cities)\n","# 3. Add a new city to list.\n","cities.append(\"Canmore\")\n","print(\"After adding a city:\", cities)\n","# 4. Remove the second city using either remove() or pop().\n","cities.pop(1)\n","print(\"After removing the second city:\", cities)\n","# 5. Sort the list alphabetically\n","cities.sort()\n","print(\"After sorting:\", cities)\n","# 6. Print your final list\n","print(\"Final list:\", cities)"]},{"cell_type":"code","execution_count":20,"id":"rr53uJwQ9uAe","metadata":{"id":"rr53uJwQ9uAe","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1761264681785,"user_tz":360,"elapsed":34,"user":{"displayName":"Johir Babor","userId":"12071800784136629308"}},"outputId":"9fe887c6-d598-4e60-f386-5d53a0ef0740"},"outputs":[{"output_type":"stream","name":"stdout","text":["Favorite numbers tuple: (7, 13, 21)\n","Error: 'tuple' object does not support item assignment\n","Explanation: Tuples are immutable, meaning: their elements cannot be changed after creation.\n"]}],"source":["# Tuples (2 marks)\n","\n","# 1. Create a tuple of 3 favorite numbers.\n","favorite_numbers = (7, 13, 21)\n","# 2. Print the tuple.\n","print(\"Favorite numbers tuple:\", favorite_numbers)\n","# 3. Try to modify the second element. Does that work? Explain.\n","try:\n","    favorite_numbers[1] = 99\n","except TypeError as e:\n","    print(f\"Error: {e}\")\n","    print(\"Explanation: Tuples are immutable, meaning: their elements cannot be changed after creation.\")"]},{"cell_type":"code","execution_count":21,"id":"abx1OwgJW6hw","metadata":{"id":"abx1OwgJW6hw","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1761264759970,"user_tz":360,"elapsed":23,"user":{"displayName":"Johir Babor","userId":"12071800784136629308"}},"outputId":"bbbf00a5-1523-4a53-c9cd-da0c12e1f47b"},"outputs":[{"output_type":"stream","name":"stdout","text":["Original visa form: {'Name': 'Johir Babor', 'File Number': 123456, 'Country': 'Canada', 'Visa Type': 'Student', 'Expiry Year': 2027}\n","After adding University: {'Name': 'Johir Babor', 'File Number': 123456, 'Country': 'Canada', 'Visa Type': 'Student', 'Expiry Year': 2027, 'University': 'University of Calgary'}\n","After updating Expiry Year: {'Name': 'Johir Babor', 'File Number': 123456, 'Country': 'Canada', 'Visa Type': 'Student', 'Expiry Year': 2028, 'University': 'University of Calgary'}\n","Final visa form: {'Name': 'Johir Babor', 'File Number': 123456, 'Country': 'Canada', 'Visa Type': 'Student', 'Expiry Year': 2028, 'University': 'University of Calgary'}\n"]}],"source":["# Dictionaries (2 marks)\n","\n","# 1. Create a dictionary representing a mini visa form with keys like:\n","# \"Name\", \"File Number\", \"Country\", \"Visa Type\", \"Expiry Year\"\n","# Assign fictional values to the keys.\n","# Note: Dictionaries can contain values of different data types.\n","visa_form = {\n","    \"Name\": \"Johir Babor\",\n","    \"File Number\": 123456,\n","    \"Country\": \"Canada\",\n","    \"Visa Type\": \"Student\",\n","    \"Expiry Year\": 2027\n","}\n","# 2. Print the dictionary\n","print(\"Original visa form:\", visa_form)\n","# 3. Add a new key \"University\" with a value\n","visa_form[\"University\"] = \"University of Calgary\"\n","print(\"After adding University:\", visa_form)\n","# 4. Update \"Expiry Year\" to a new year\n","visa_form[\"Expiry Year\"] = 2028\n","print(\"After updating Expiry Year:\", visa_form)\n","# 5. Print the final dictionary\n","print(\"Final visa form:\", visa_form)"]},{"cell_type":"code","execution_count":22,"id":"uqp6pK8VZGD9","metadata":{"id":"uqp6pK8VZGD9","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1761264827828,"user_tz":360,"elapsed":47,"user":{"displayName":"Johir Babor","userId":"12071800784136629308"}},"outputId":"f12614ea-5208-40ab-fe08-b31412c97daf"},"outputs":[{"output_type":"stream","name":"stdout","text":["Set 1: {'Math', 'Physics', 'Biology', 'History', 'English'}\n","Set 2: {'Math', 'Physics', 'Chemistry', 'Geography', 'English'}\n","Union: {'Physics', 'Math', 'Geography', 'Chemistry', 'Biology', 'History', 'English'}\n","Intersection: {'Math', 'English', 'Physics'}\n","Difference (subjects1 - subjects2): {'History', 'Biology'}\n"]}],"source":["# Sets (2 marks)\n","\n","# Set 1\n","subjects1 = {\"Math\", \"English\", \"Physics\", \"Biology\", \"History\"}\n","\n","# Set 2\n","subjects2 = {\"Math\", \"English\", \"Chemistry\", \"Geography\", \"Physics\"}\n","\n","# Tip: Use f-strings to print clear messages along with your output.\n","# Eg. \"Union: \", \"Intersection: \"\n","\n","# 1. Print both the sets\n","print(f\"Set 1: {subjects1}\")\n","print(f\"Set 2: {subjects2}\")\n","# 2. Print the union of sets\n","print(f\"Union: {subjects1.union(subjects2)}\")\n","# 3. Print the intersection of sets\n","print(f\"Intersection: {subjects1.intersection(subjects2)}\")\n","# 4. Print the difference (subjects1 - subjects2)\n","print(f\"Difference (subjects1 - subjects2): {subjects1.difference(subjects2)}\")"]},{"cell_type":"code","execution_count":23,"id":"kAEpKNfQtl8n","metadata":{"id":"kAEpKNfQtl8n","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1761264910675,"user_tz":360,"elapsed":34,"user":{"displayName":"Johir Babor","userId":"12071800784136629308"}},"outputId":"415f78c2-194d-443f-ff6d-01ebc654e4c7"},"outputs":[{"output_type":"stream","name":"stdout","text":["Bank Name: Canada Bank\n","Deposited $500. Updated balance: $1500\n","Withdrew $200. Updated balance: $1300\n","Account Holder: Johir Babor, Current Balance: $1300\n"]}],"source":["# Classes and Function (3 marks)\n","\n","# Step 1: Create a class BankAccount.\n","# Add class attribute bankname=\"Canada Bank\"\n","# Add 2 instance attributes: account_holder (string) & balance (float, default value 0.0)\n","\n","# Step 2: Add methods\n","# 1. deposit(amount) -> Add amount to the balance\n","# 2. withdraw(amount) -> Subtract the amount if balance is sufficient, else print an error message\n","# 3. get_balance() -> Print Account holder's name and current balance\n","# 4. get_bankname() -> Print the class attribute (staticmethod)\n","# Note: Use f-strings to display the amount and updated balance whenever you call deposit() or withdraw()\n","class BankAccount:\n","    bankname = \"Canada Bank\"\n","\n","    def __init__(self, account_holder, balance=0.0):\n","        self.account_holder = account_holder\n","        self.balance = balance\n","\n","    def deposit(self, amount):\n","        self.balance += amount\n","        print(f\"Deposited ${amount}. Updated balance: ${self.balance}\")\n","\n","    def withdraw(self, amount):\n","        if amount <= self.balance:\n","            self.balance -= amount\n","            print(f\"Withdrew ${amount}. Updated balance: ${self.balance}\")\n","        else:\n","            print(f\"Error: Insufficient balance. Current balance: ${self.balance}\")\n","\n","    def get_balance(self):\n","        print(f\"Account Holder: {self.account_holder}, Current Balance: ${self.balance}\")\n","\n","    @staticmethod\n","    def get_bankname():\n","        print(f\"Bank Name: {BankAccount.bankname}\")\n","\n","# Step 3: Test\n","# 1. Print the Bankname\n","BankAccount.get_bankname()\n","# 2. Create an object of BankAccount with your name and an initial balance of 1000\n","my_account = BankAccount(\"Johir Babor\", 1000)\n","# 3. Deposit 500\n","my_account.deposit(500)\n","# 4. Withdraw 200\n","my_account.withdraw(200)\n","# 5. Print the final balance\n","my_account.get_balance()"]},{"cell_type":"markdown","id":"b45a5575-8e77-4bba-8311-69f997affc35","metadata":{"id":"b45a5575-8e77-4bba-8311-69f997affc35"},"source":["## Part 3: Using Pandas for Data Management and Analytics\n","### (15 marks)"]},{"cell_type":"code","execution_count":null,"id":"6dbaa42e-22e3-4aa6-9bd3-dd9ede274c17","metadata":{"id":"6dbaa42e-22e3-4aa6-9bd3-dd9ede274c17"},"outputs":[],"source":["# In the space below, please import the Pandas library\n","#"]},{"cell_type":"code","execution_count":null,"id":"cce8e74f-bba1-4bf4-baaf-13e23cdf4afc","metadata":{"id":"cce8e74f-bba1-4bf4-baaf-13e23cdf4afc"},"outputs":[],"source":["# Load the student grade CSV files into DataFrames using the defined variables\n","# (1 marks)\n","df_english =\n","df_math ="]},{"cell_type":"code","execution_count":null,"id":"O0FyC8aftofz","metadata":{"id":"O0FyC8aftofz"},"outputs":[],"source":["# Print the first 5 rows of df_english using the .head method\n","#"]},{"cell_type":"code","execution_count":null,"id":"G-RxspCFtrsf","metadata":{"id":"G-RxspCFtrsf"},"outputs":[],"source":["# Print the first 5 rows of df_math using the .head method\n","#"]},{"cell_type":"code","execution_count":null,"id":"8fb240f4-6358-4f61-ab12-f0134c0144a8","metadata":{"id":"8fb240f4-6358-4f61-ab12-f0134c0144a8"},"outputs":[],"source":["# Merging the DataFrames on 'studentID'\n","df_studentGrades = pd.merge(df_english, df_math, on='studentID', suffixes=('_English', '_Math'))"]},{"cell_type":"code","execution_count":null,"id":"a9e571ef-d61b-4594-a181-503dca3fe49b","metadata":{"id":"a9e571ef-d61b-4594-a181-503dca3fe49b"},"outputs":[],"source":["# Take a look at the data contained in the csv files. Why is studentID chosen as the key?\n","# (0.5 mark)\n","#"]},{"cell_type":"code","execution_count":null,"id":"P9DzFohwzluP","metadata":{"id":"P9DzFohwzluP"},"outputs":[],"source":["# You will notice that all the column names got suffixes except studentID.\n","# Explain why pandas didn't add suffixes to the studentID column.\n","#"]},{"cell_type":"code","execution_count":null,"id":"e23aaa90-fb4c-43f9-a3fc-1ae850bf65ab","metadata":{"id":"e23aaa90-fb4c-43f9-a3fc-1ae850bf65ab"},"outputs":[],"source":["# Let's calculate the average GPA across the two classes for each student\n","df_studentGrades['GPA'] = df_studentGrades[['grade_English', 'grade_Math']].mean(axis=1)\n","\n","# Now let's check the data! In the space below, please use the .head method to display the dataframe.\n","# (1 mark)\n","#"]},{"cell_type":"code","execution_count":null,"id":"9f28f907-7e7d-4be4-87b8-db03fef69dfa","metadata":{"id":"9f28f907-7e7d-4be4-87b8-db03fef69dfa"},"outputs":[],"source":["# Do you notice a problem? The rows for first name and last name have been duplicated!\n","# .drop(columns=['<column_name1>','<column_name2>'] is a Pandas method that can be used to drop columns.\n","# In the space below, drop the first name and last name associated with the math .csv file.\n","# (2 mark)\n","df_studentGrades ="]},{"cell_type":"code","execution_count":null,"id":"b58186b4-b60e-455a-990e-b24169964f98","metadata":{"id":"b58186b4-b60e-455a-990e-b24169964f98"},"outputs":[],"source":["# Let's display the data again. Use an appropriate method (hint: already used before)\n","# (0.5 mark)\n","#"]},{"cell_type":"code","execution_count":null,"id":"f0476460-6156-49ee-bc84-0878207e2dfa","metadata":{"id":"f0476460-6156-49ee-bc84-0878207e2dfa"},"outputs":[],"source":["# Let's also rename the first and last names appropriately.\n","# Complete the code in the space below by replacing \"<>\" with the proper column name\n","# (1 mark)\n","\n","df_studentGrades = df_studentGrades.rename(columns={\n","    'firstName_English': 'firstName',\n","    '<>': 'lastName',\n","    '<>': 'englishGrade',\n","    '<>': 'mathGrade'\n","    })"]},{"cell_type":"code","execution_count":null,"id":"5c2b26e6-3c03-4950-b5